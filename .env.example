# Which embedding backend to use: "local_bge" (default) or "gemini"
EMBEDDING_PROVIDER=local_bge

# Which reranker backend to use: "local_cross_encoder" (default) or "cohere"
RERANKER_PROVIDER=local_cross_encoder

# Required only if EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=

# Required only if RERANKER_PROVIDER=cohere
COHERE_API_KEY=

# LLM fallback providers (agent loop + synthesis), used when Gemini's daily
# quota is exhausted mid-eval-run. All optional — failover is skipped for any
# provider without a key set. See ADR-007.
GROQ_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
CEREBRAS_API_KEY=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_copilot
